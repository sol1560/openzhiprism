# 知乎开放平台 Access Secret（developer.zhihu.com/personal）
ZHIHU_ACCESS_SECRET=
# 正式 OAuth 凭证通过知乎审核发放，与 Access Secret 不同
ZHIHU_OAUTH_APP_ID=
ZHIHU_OAUTH_APP_KEY=
# 以下字段必须依据获批官方材料填写；没有默认身份接口或字段猜测
ZHIHU_OAUTH_USERINFO_URL=
ZHIHU_OAUTH_SUBJECT_PATH=
ZHIHU_OAUTH_NAME_PATH=
# 仅在身份契约与 state 回传均完成真实联调后启用
ZHIHU_OAUTH_CONTRACT_VERIFIED=false
# production 自动进入公开模式；开发环境可显式验证公开访问限制
APP_PUBLIC_MODE=false
# 站点对外地址（OAuth issuer、邮件链接）。浏览器写请求按「与本次请求同源」校验，本地任何端口都能用，不必为换端口改这里
NEXT_PUBLIC_APP_URL=http://localhost:3000
# 登录：邮箱验证码（Resend 发信）与 Google OAuth
# 本地开发不填 RESEND_API_KEY 时，验证码直接打印在 dev server 终端；公开模式必须配置
RESEND_API_KEY=
# 沙箱发件人只能发给 Resend 账号本人；上线请换成已验证域名的地址
EMAIL_FROM=知棱 ZhiPrism <onboarding@resend.dev>
# Google Cloud Console 的 OAuth 客户端；回调地址填 ${NEXT_PUBLIC_APP_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Pangram 只在服务端调用；总开关默认关闭
PANGRAM_API_KEY=
AI_DETECTION_ENABLED=false
AI_DETECTION_USER_DAILY=5
AI_DETECTION_USER_MINUTE=2
AI_DETECTION_DAILY_CENTS=500
AI_DETECTION_ROLLING_CENTS=15000
# JustOne API（api.justoneapi.com），官方配额不足时的补充内容源
JUSTONEAPI_TOKEN=
# ZenMux（OpenAI 兼容网关 https://zenmux.ai/api/v1）
ZENMUX_API_KEY=
# LLM 供应商：zenmux | zhida | mock
LLM_PROVIDER=mock
LLM_MODEL=deepseek/deepseek-v4-flash
# 内容源策略：auto | official | justone | fixture
ZHIHU_SOURCE=auto
DATABASE_URL=file:./data/zhiprism.db
# 仅远程 libSQL 数据库需要；本地 SQLite 留空。Vercel Marketplace 的 Turso 集成会注入 TURSO_DATABASE_URL / TURSO_AUTH_TOKEN，无需再填 DATABASE_*
DATABASE_AUTH_TOKEN=
# 本地文件库默认在首个请求时自动迁移；远程库默认 false，部署后执行 pnpm db:migrate
DATABASE_MIGRATE_ON_START=
# 语音向导「小棱」（ElevenLabs Agents）。API key 只在服务端换取 signed URL；agent 由 pnpm voice:sync 创建并打印 id
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
# 可选：Voice Library 里支持中文的 voice id；留空用 ElevenLabs 默认声音
ELEVENLABS_VOICE_ID=
# 两个 key 都配置后默认开启；设为 false 可临时隐藏语音面板
VOICE_GUIDE_ENABLED=

# 证据、短程思辨与我的判断；false 可关闭新入口，保留既有 Feed
COGNITION_ENABLED=true
